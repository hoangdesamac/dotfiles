#!/bin/bash

# ==========================================
# CẤU HÌNH HỆ THỐNG
# ==========================================
SDK=${ANDROID_HOME:-"$HOME/Android/Sdk"}
ADB="$SDK/platform-tools/adb"
EMU="$SDK/emulator/emulator"
AVD_NAME="MyPixel"
HISTORY_FILE="$HOME/.local/share/adev_history"

# Cấu hình căn lề (Theo ý bạn)
MARGIN_RIGHT=10
MARGIN_BOTTOM=45

# Tạo file history nếu chưa có
if [ ! -f "$HISTORY_FILE" ]; then
  mkdir -p "$(dirname "$HISTORY_FILE")"
  touch "$HISTORY_FILE"
fi

# ==========================================
# 1. HÀM XỬ LÝ PROJECT
# ==========================================

is_android_project() {
  if [ -f "build.gradle" ] || [ -f "build.gradle.kts" ] ||
    [ -f "settings.gradle" ] || [ -f "settings.gradle.kts" ]; then
    return 0
  else
    return 1
  fi
}

save_to_history() {
  local current_dir=$(pwd)
  grep -vxF "$current_dir" "$HISTORY_FILE" >"${HISTORY_FILE}.tmp" 2>/dev/null
  echo "$current_dir" | cat - "${HISTORY_FILE}.tmp" >"$HISTORY_FILE"
  rm "${HISTORY_FILE}.tmp"
}

select_project() {
  echo "📂 Danh sách dự án Android cũ:"
  if [ ! -s "$HISTORY_FILE" ]; then
    echo "❌ Lịch sử trống."
    return
  fi
  local selected=$(cat "$HISTORY_FILE" | fzf --height=40% --layout=reverse --border --prompt="Chọn dự án > ")

  if [ -n "$selected" ]; then
    cd "$selected" || exit
    echo "✅ Đã chuyển tới: $selected"
    run_auto_dev
  else
    echo "❌ Chưa chọn dự án nào."
    exit 0
  fi
}

# ==========================================
# 2. LOGIC CHÍNH (AUTO DEV)
# ==========================================

run_auto_dev() {
  # --- 1. Lấy Package Name ---
  local pkg=$(grep -m 1 "namespace =" app/build.gradle.kts 2>/dev/null | awk -F'"' '{print $2}' | tr -d '[:space:]')
  if [ -z "$pkg" ]; then pkg=$(grep -m 1 "namespace" app/build.gradle 2>/dev/null | awk -F'"' '{print $2}' | tr -d '[:space:]'); fi
  if [ -z "$pkg" ]; then pkg=$(grep -m 1 "applicationId" app/build.gradle 2>/dev/null | awk -F'"' '{print $2}' | tr -d '[:space:]'); fi

  if [ -z "$pkg" ]; then
    echo "❌ Lỗi: Không tìm thấy 'namespace'. Kiểm tra lại thư mục dự án."
    exit 1
  fi

  echo "🚀 Auto-Dev: $pkg"
  echo "📍 Dir: $(pwd)"
  save_to_history

  # --- 2. Khởi động Máy ảo & Căn chỉnh ---
  if ! $ADB get-state 1>/dev/null 2>&1; then
    echo "⚡ Đang bật máy ảo $AVD_NAME..."

    # Bật máy ảo (Silent Mode)
    $EMU -avd $AVD_NAME -gpu host -accel on -no-audio -no-boot-anim -memory 4096 >/dev/null 2>&1 &

    echo "👀 Đang săn cửa sổ máy ảo..."
    while ! xdotool search --name "Android Emulator" >/dev/null 2>&1; do sleep 0.5; done
    sleep 2 # Đợi render GUI

    # --- ĐOẠN CODE CĂN CHỈNH GÓC PHẢI DƯỚI (Của bạn) ---
    if command -v xdotool &>/dev/null && command -v wmctrl &>/dev/null; then
      WIN_ID=$(xdotool search --name "Android Emulator" | head -n 1)

      # 1. Bấm phím tắt để chuyển sang Floating Mode
      xdotool key --window $WIN_ID Super+Shift+f

      # 2. Tính toán toạ độ
      eval $(xdotool getwindowgeometry --shell $WIN_ID)
      SCREEN_W=$(xdotool getdisplaygeometry | awk '{print $1}')
      SCREEN_H=$(xdotool getdisplaygeometry | awk '{print $2}')

      POS_X=$((SCREEN_W - WIDTH - MARGIN_RIGHT))
      POS_Y=$((SCREEN_H - HEIGHT - MARGIN_BOTTOM))

      # Chặn lỗi số âm
      if [ $POS_X -lt 0 ]; then POS_X=0; fi
      if [ $POS_Y -lt 0 ]; then POS_Y=0; fi

      # 3. Di chuyển và Ghim (Above)
      wmctrl -i -r $WIN_ID -e 0,$POS_X,$POS_Y,-1,-1
      wmctrl -i -r $WIN_ID -b add,above
      echo "📍 Đã ghim tại: X=$POS_X, Y=$POS_Y"
    fi

    echo "⏳ Đang đợi hệ điều hành Android boot xong..."
    $ADB wait-for-device
    while [ "$($ADB shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" != "1" ]; do sleep 1; done
    echo "✅ Máy ảo sẵn sàng!"
  fi

  # --- 3. Build & Watch (ĐÃ TỐI ƯU TỐC ĐỘ) ---
  echo "🔨 Build lần đầu (Skip lint/check)..."
  # TỐI ƯU: Thêm -x lint -x test -x check
  ./gradlew installDebug --daemon --parallel --max-workers=4 -x lint -x test -x check >/dev/null 2>&1
  if [ $? -eq 0 ]; then
    $ADB shell am start -n $pkg/.MainActivity >/dev/null 2>&1
    echo "📲 App đã mở!"
  fi

  echo "👀 Đang theo dõi code (Ctrl+C để thoát)..."
  while true; do
    inotifywait -r -e modify,create,delete --exclude '.*\.tmp' app/src 2>/dev/null

    echo "⏳ Chờ save..."
    sleep 0.2 # TỐI ƯU: Giảm thời gian chờ xuống 0.2s
    while read -t 0.1; do :; done

    echo "🚀 Speed Building..."
    # TỐI ƯU: Thêm -x lint -x test -x check vào cả 2 lệnh build
    if ./gradlew installDebug --daemon --offline --parallel --max-workers=4 -x lint -x test -x check >/dev/null 2>&1; then
      echo "✅ Build xong! Reloading..."
      $ADB shell am force-stop $pkg
      $ADB shell monkey -p $pkg -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
      if [ $? -ne 0 ]; then $ADB shell am start -n $pkg/.MainActivity >/dev/null 2>&1; fi
    else
      echo "⚠️  Lỗi Build Offline. Đang thử Online..."
      ./gradlew installDebug --daemon --parallel -x lint -x test -x check
    fi
  done
}

# ==========================================
# 3. ĐIỀU HƯỚNG
# ==========================================

if is_android_project; then
  run_auto_dev
else
  if [ -s "$HISTORY_FILE" ]; then
    select_project
  else
    echo "ℹ️  Không tìm thấy dự án Android tại đây."
    echo "👉 Hãy cd vào thư mục dự án."
  fi
fi
